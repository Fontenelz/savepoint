generator client {
  provider      = "prisma-client-js"
  // "native" para desenvolvimento; rhel-openssl-3.0.x para as funções da Vercel
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlayStatus {
  BACKLOG
  PLAYING
  PAUSED
  COMPLETED
  MASTERED
  DROPPED
  ENDLESS
}

/// De onde veio o jogo. O banco local é sempre a fonte da verdade;
/// provedores externos (IGDB) apenas copiam dados para cá.
enum CatalogSource {
  LOCAL
  COMMUNITY
  IGDB
  STEAM
  RAWG
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  /// Null para quem só entra pelo Google.
  passwordHash String?
  /// "sub" da conta Google (login com Google).
  googleId     String?  @unique
  /// Nome e foto da conta Google, atualizados a cada login com Google.
  googleName   String?
  googleAvatar String?
  displayName  String
  bio          String?
  avatarHue    Int      @default(200)
  /// Foto exibida no site: da Steam; sem Steam, do Google; sem nenhuma, a silhueta (ver account-profile.ts).
  avatarUrl    String?
  createdAt    DateTime @default(now())

  /// Conta Steam vinculada (SteamID64), para importar biblioteca e horas.
  steamId       String?   @unique
  steamName     String?
  steamAvatar   String?
  steamLinkedAt DateTime?
  steamSyncedAt DateTime?

  library      UserGame[]
  logs         LogEntry[]
  saves        Save[]
  lists        GameList[]
  reviewLikes  ReviewLike[]
  comments     ReviewComment[]
  following    Follow[]   @relation("follower")
  followers    Follow[]   @relation("following")
  gamesCreated Game[]     @relation("createdBy")
}

model Game {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  summary     String?
  releaseYear Int?
  developer   String?
  publisher   String?
  coverUrl    String?
  /// Arte horizontal para o banner da página do jogo.
  backdropUrl String?
  /// Vínculo com o IGDB (preenchido por importação ou pelo catalog:sync).
  igdbId      String?       @unique
  /// Slug na RAWG (importação em massa; também é a chave da propriedade P9968 do Wikidata).
  rawgId      String?       @unique
  /// IDs abertos descobertos via Wikidata (o Steam também habilita importar bibliotecas no futuro).
  wikidataId  String?
  steamAppId  String?
  /// Avaliações da loja da Steam: % positivas e total. Base da nota sugerida (nunca entra na média do site).
  steamScore       Int?
  steamReviewCount Int?
  /// Tempo médio para zerar (curadoria/fonte externa).
  avgHours    Float?
  /// Sugestão (não regra) de jogo sem final definido: esportes, MMO, só multijogador. Destaca "Sem fim".
  endlessHint Boolean       @default(false)
  source      CatalogSource @default(LOCAL)
  externalId  String?
  createdById String?
  createdBy   User?         @relation("createdBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  // Estatísticas desnormalizadas (atualizadas pelo StatsService)
  ratingAvg   Float?
  ratingCount Int @default(0)
  playerCount Int @default(0)
  likeCount   Int @default(0)

  genres    Genre[]
  platforms Platform[]
  entries   UserGame[]
  logs      LogEntry[]
  saves     Save[]
  listItems ListItem[]

  @@unique([source, externalId])
  @@index([steamAppId])
  @@index([playerCount])
  @@index([ratingAvg])
}

model Genre {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  games Game[]
}

model Platform {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  short     String
  sortOrder Int        @default(100)
  games     Game[]
  entries   UserGame[]
  logs      LogEntry[]
  saves     Save[]
}

/// A "estante": o estado atual de um jogo para um usuário.
model UserGame {
  id           String      @id @default(cuid())
  userId       String
  gameId       String
  status       PlayStatus?
  /// 1–10 (meia estrela = 1)
  rating       Int?
  liked        Boolean     @default(false)
  /// 1–4: posição no "Top 4" do perfil
  favoriteRank Int?
  platformId   String?
  hoursPlayed  Float?
  startedAt    DateTime?   @db.Date
  finishedAt   DateTime?   @db.Date
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game     Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  platform Platform? @relation(fields: [platformId], references: [id], onDelete: SetNull)

  @@unique([userId, gameId])
  @@unique([userId, favoriteRank])
  @@index([gameId, status])
}

/// Save = uma jornada completa com o jogo (Save 1, Save 2… ao rejogar).
/// Aberto: PLAYING/PAUSED (e ENDLESS, que nunca fecha). Fechado: COMPLETED/MASTERED/DROPPED.
/// Nota e review do save só com ele fechado (ou ENDLESS). A nota oficial do jogo fica em
/// UserGame.rating: a pessoa escolhe se a nota de um save novo a substitui.
model Save {
  id         String     @id @default(cuid())
  userId     String
  gameId     String
  /// 1, 2, 3… por usuário e jogo
  number     Int
  status     PlayStatus
  startedAt  DateTime?  @db.Date
  endedAt    DateTime?  @db.Date
  platformId String?
  hours      Float?
  /// 1–10 (meia estrela = 1)
  rating     Int?
  liked      Boolean    @default(false)
  review     String?
  spoiler    Boolean    @default(false)
  /// Quando a review foi publicada (ordena as reviews)
  reviewedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  platform    Platform?       @relation(fields: [platformId], references: [id], onDelete: SetNull)
  checkpoints LogEntry[]
  likes       ReviewLike[]
  comments    ReviewComment[]

  @@unique([userId, gameId, number])
  @@index([gameId, reviewedAt])
  @@index([userId, reviewedAt])
}

enum CheckpointKind {
  /// Sessão/anotação registrada pelo jogador
  SESSION
  /// Começou o save (automático)
  STARTED
  /// Fechou o save: zerou, fez 100% ou abandonou (automático)
  CLOSED
}

/// Checkpoint: um registro do diário dentro de um save. Não tem nota nem review.
model LogEntry {
  id         String         @id @default(cuid())
  userId     String
  gameId     String
  saveId     String
  kind       CheckpointKind @default(SESSION)
  playedOn   DateTime       @db.Date
  platformId String?
  hours      Float?
  note       String?
  spoiler    Boolean        @default(false)
  isPublic   Boolean        @default(true)
  createdAt  DateTime       @default(now())

  /// Legado (antes dos saves): mantidos só para conferência/rollback. Não usar.
  finished Boolean @default(false)
  replay   Boolean @default(false)
  rating   Int?
  liked    Boolean @default(false)
  review   String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game     Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  save     Save      @relation(fields: [saveId], references: [id], onDelete: Cascade)
  platform Platform? @relation(fields: [platformId], references: [id], onDelete: SetNull)

  @@index([userId, playedOn])
  @@index([gameId, createdAt])
  @@index([saveId, playedOn])
}

/// Curtida numa review (de um save).
model ReviewLike {
  userId    String
  saveId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  save      Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)

  @@id([userId, saveId])
}

/// Resposta a uma review (de um save).
model ReviewComment {
  id        String   @id @default(cuid())
  saveId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  save      Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([saveId, createdAt])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model GameList {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  ranked      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ListItem[]
}

model ListItem {
  id       String   @id @default(cuid())
  listId   String
  gameId   String
  position Int
  note     String?
  list     GameList @relation(fields: [listId], references: [id], onDelete: Cascade)
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([listId, gameId])
  @@index([listId, position])
}

/// Tentativas de login com senha errada por conta (proteção contra força bruta).
/// Fica no banco porque, em funções serverless, cada instância tem sua própria memória.
model LoginThrottle {
  key         String   @id
  failures    Int      @default(0)
  windowStart DateTime @default(now())
}
