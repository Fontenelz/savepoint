{
  "name": "@savepoint/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:seed": "tsx prisma/seed.ts && nest build && node dist/catalog/sync.cli.js --optional",
    "catalog:sync": "nest build && node dist/catalog/sync.cli.js"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.6",
    "@prisma/orm-postgres": "8.0.0-rc.23",
    "@savepoint/shared": "workspace:*",
    "@vercel/blob": "^2.9.0",
    "arktype": "^2.2.3",
    "bcryptjs": "^3.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/node": "^22.18.6",
    "prisma": "8.0.0-rc.33",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
