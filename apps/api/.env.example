DATABASE_URL="postgresql://savepoint:savepoint@localhost:5433/savepoint?schema=public"
JWT_SECRET="troque-isto-por-um-segredo-longo"
PORT=3333
WEB_ORIGIN="http://localhost:3000"

# Opcional — habilita a importação de jogos do IGDB (via Twitch).
# Sem essas variáveis o app funciona 100% com o catálogo local.
# https://api-docs.igdb.com/#account-creation
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""

# Produção (Vercel) — armazenamento das capas/banners no Vercel Blob.
# Sem esta variável as imagens ficam no disco local (storage/media).
# BLOB_READ_WRITE_TOKEN=""

# Opcional — conectar conta Steam e importar biblioteca/horas.
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=""

# Opcional — importação em massa da RAWG (pnpm catalog:import --source rawg).
# https://rawg.io/apidocs
RAWG_API_KEY=""

# Opcional — login com Google. Redirect autorizado no console: http://localhost:3000/auth/google/callback
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
