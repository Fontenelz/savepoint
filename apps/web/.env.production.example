# ─────────────────────────────────────────────────────────────
# Savepoint Web — variáveis de PRODUÇÃO (projeto `savepoint-web` na Vercel)
# Cadastre em Settings → Environment Variables (ambiente Production).
# Este arquivo é só referência: NUNCA coloque valores reais aqui.
# Passo a passo completo em DEPLOY.md.
# ─────────────────────────────────────────────────────────────

# URL pública do projeto da API. Precisa terminar em /api.
# Usada só no servidor do Next (Server Components e Server Actions).
API_URL="https://SEU-PROJETO-API.vercel.app/api"

# Faz a Vercel usar o pnpm 12 definido no package.json (via corepack).
ENABLE_EXPERIMENTAL_COREPACK=1

# Endereço público do site (canônicas, sitemap, imagens de compartilhamento).
# Troque aqui se o domínio mudar. Sem ela, usa o domínio de produção informado pela Vercel.
SITE_URL="https://savepoint-hub.vercel.app"

# Não definir: DEV_ORIGINS é só para o dev server.
# NODE_ENV=production é definida pela Vercel (ativa o cookie `secure`, exige HTTPS).
