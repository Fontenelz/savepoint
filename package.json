{
  "name": "savepoint",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @savepoint/api db:migrate",
    "db:seed": "pnpm --filter @savepoint/api db:seed",
    "db:reset": "pnpm --filter @savepoint/api db:reset",
    "catalog:sync": "pnpm --filter @savepoint/api catalog:sync",
    "catalog:import": "pnpm --filter @savepoint/api catalog:import",
    "catalog:enrich": "pnpm --filter @savepoint/api catalog:enrich",
    "stats:refresh": "pnpm --filter @savepoint/api stats:refresh"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
